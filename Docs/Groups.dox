/**
 * @defgroup quiet_systems C++ Reference
 * @brief C++ reference organized by system responsibility.
 *
 * Groups are populated incrementally as their source declarations
 * receive documentation. Group membership does not imply that a
 * system's documentation is complete.
 */


/**
 * @defgroup quiet_foundations Foundations
 * @ingroup quiet_systems
