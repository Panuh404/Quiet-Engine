# Project

DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME            = "Quiet Engine"
PROJECT_BRIEF           = "C++20 Vulkan engine and editor"
OUTPUT_LANGUAGE         = English
OUTPUT_DIRECTORY        = "@QUIET_DOCS_OUTPUT_DIR@"

# Handbook and Quiet-owned source

INPUT                   = "@QUIET_DOCS_SOURCE_ROOT@/README.md" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Docs" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Engine/include" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Engine/src" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Launcher/src" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Editor/src" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Sandbox/src" \
                          "@QUIET_DOCS_SOURCE_ROOT@/Cooker/src"

INPUT_ENCODING          = UTF-8
FILE_PATTERNS           = *.h *.hpp *.c *.cpp *.md *.dox
RECURSIVE               = YES
EXCLUDE                 = "@QUIET_DOCS_SOURCE_ROOT@/Docs/ThirdParty"

FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = "@QUIET_DOCS_SOURCE_ROOT@/"
MARKDOWN_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE   = "@QUIET_DOCS_SOURCE_ROOT@/Docs/README.md"

# Initial browsable reference; this is not a coverage check

EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
EXTRACT_LOCAL_CLASSES   = NO
HIDE_UNDOC_NAMESPACES   = NO

# Source navigation

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO

# HTML and theme

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
FULL_SIDEBAR            = NO
SEARCHENGINE            = YES
HTML_COLORSTYLE         = LIGHT
HTML_EXTRA_STYLESHEET   = "@QUIET_DOCS_THEME_DIR@/doxygen-awesome.css"

# Other output formats

GENERATE_LATEX          = NO
GENERATE_XML            = NO
GENERATE_RTF            = NO
GENERATE_MAN            = NO
GENERATE_DOCBOOK        = NO

# Diagnostics

QUIET                   = NO
WARNINGS                = YES
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_AS_ERROR           = NO
WARN_LOGFILE            = "@QUIET_DOCS_OUTPUT_DIR@/warnings.log"

# Graph generation

HAVE_DOT                = NO
CLASS_GRAPH             = NO
COLLABORATION_GRAPH     = NO
GROUP_GRAPHS            = NO
DIRECTORY_GRAPH         = NO
INCLUDE_GRAPH           = NO
INCLUDED_BY_GRAPH       = NO
GRAPHICAL_HIERARCHY     = NO