{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "ON",
        "QUIET_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "ON",
        "QUIET_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "debug-editor",
      "displayName": "Debug Editor",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Debug-Editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "ON"
      }
    },
    {
      "name": "release-editor",
      "displayName": "Release Editor",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Release-Editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "debug"
    },
    {
      "name": "build-release",
      "configurePreset": "release"
    },
    {
      "name": "build-debug-editor",
      "configurePreset": "debug-editor",
      "targets": [
        "Quiet_Editor"
      ]
    },
    {
      "name": "build-release-editor",
      "configurePreset": "release-editor",
      "targets": [
        "Quiet_Editor"
      ]
    }
  ]
}