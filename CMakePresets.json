{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug-sandbox",
      "displayName": "Debug Sandbox",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Debug-Sandbox",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "ON",
        "QUIET_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "release-sandbox",
      "displayName": "Release Sandbox",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Release-Sandbox",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "ON",
        "QUIET_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "debug-editor",
      "displayName": "Debug Editor",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Debug-Editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "ON"
      }
    },
    {
      "name": "release-editor",
      "displayName": "Release Editor",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Release-Editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "ON"
      }
    },
    {
      "name": "debug-launcher",
      "displayName": "Debug Launcher",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Debug-Launcher",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "ON",
        "QUIET_BUILD_LAUNCHER": "ON"
      }
    },
    {
      "name": "release-launcher",
      "displayName": "Release Launcher",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Release-Launcher",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "ON",
        "QUIET_BUILD_LAUNCHER": "ON"
      }
    },
    {
      "name": "debug-cooker",
      "displayName": "Debug Cooker",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Debug-Cooker",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "OFF",
        "QUIET_BUILD_LAUNCHER": "OFF",
        "QUIET_BUILD_COOKER": "ON"
      }
    },
    {
      "name": "release-cooker",
      "displayName": "Release Cooker",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Intermediate/Release-Cooker",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QUIET_BUILD_SANDBOX": "OFF",
        "QUIET_BUILD_EDITOR": "OFF",
        "QUIET_BUILD_LAUNCHER": "OFF",
        "QUIET_BUILD_COOKER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug-sandbox",
      "configurePreset": "debug-sandbox",
      "targets": [ "Quiet_Sandbox" ]
    },
    {
      "name": "build-release-sandbox",
      "configurePreset": "release-sandbox",
      "targets": [ "Quiet_Sandbox" ]
    },
    {
      "name": "build-debug-editor",
      "configurePreset": "debug-editor",
      "targets": [ "Quiet_Editor" ]
    },
    {
      "name": "build-release-editor",
      "configurePreset": "release-editor",
      "targets": [ "Quiet_Editor" ]
    },
    {
      "name": "build-debug-launcher",
      "configurePreset": "debug-launcher",
      "targets": [ "Quiet_Launcher" ]
    },
    {
      "name": "build-release-launcher",
      "configurePreset": "release-launcher",
      "targets": [ "Quiet_Launcher" ]
    },
    {
      "name": "build-debug-cooker",
      "configurePreset": "debug-cooker",
      "targets": [ "Quiet_Cooker" ]
    },
    {
      "name": "build-release-cooker",
      "configurePreset": "release-cooker",
      "targets": [ "Quiet_Cooker" ]
    }
  ]
}